<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Selamat Ulang Tahun, Gita Sari</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Poppins:wght@300;400;500;600&family=Dancing+Script:wght@500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#4A1024;
    --plum:#7A2942;
    --plum-light:#9C3B54;
    --gold:#D9A25C;
    --blush:#F0B7C4;
    --cream:#FFF6F2;
    --line: rgba(217,162,92,0.25);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background: var(--navy);
    color: var(--cream);
    font-family:'Poppins', sans-serif;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
  ::selection{ background: var(--blush); color:var(--navy); }

  h1,h2,h3{ font-family:'Playfair Display', serif; font-weight:600; letter-spacing:0.3px; }
  .script{ font-family:'Dancing Script', cursive; }
  .eyebrow{
    font-size:0.72rem;
    letter-spacing:4px;
    text-transform:uppercase;
    color: var(--gold);
    font-weight:500;
  }

  a{ color:inherit; }

  /* ---------- Background sky (fixed, shared across page) ---------- */
  #sky{
    position:fixed; inset:0; z-index:-3;
    background:
      radial-gradient(ellipse at 20% 10%, rgba(156,59,84,0.55), transparent 55%),
      radial-gradient(ellipse at 85% 25%, rgba(240,183,196,0.18), transparent 50%),
      linear-gradient(180deg, #35091A 0%, #4A1024 40%, #63182F 75%, #7A2942 100%);
  }
  .star{
    position:fixed; border-radius:50%;
    background: var(--cream);
    z-index:-2;
    animation: twinkle 4s ease-in-out infinite;
  }
  @keyframes twinkle{
    0%,100%{ opacity:0.15; transform:scale(0.8); }
    50%{ opacity:1; transform:scale(1.15); }
  }
  .heart-float{
    position:fixed; bottom:-40px; z-index:-1;
    color: var(--blush);
    opacity:0;
    animation-name: float-heart;
    animation-timing-function: ease-in;
    animation-iteration-count: infinite;
    pointer-events:none;
  }
  .heart-float svg{ width:100%; height:100%; display:block; filter: drop-shadow(0 0 6px rgba(240,183,196,0.35)); }
  @keyframes float-heart{
    0%{ transform: translate(0,0) rotate(0deg); opacity:0; }
    8%{ opacity:0.85; }
    50%{ transform: translate(var(--drift,24px), -58vh) rotate(var(--spin,8deg)); }
    88%{ opacity:0.7; }
    100%{ transform: translate(calc(var(--drift,24px)*-1), -112vh) rotate(calc(var(--spin,8deg)*-1)); opacity:0; }
  }

  section{ position:relative; padding: 7rem 1.5rem; max-width:920px; margin:0 auto; }

  /* ---------- Hero ---------- */
  #hero{
    min-height:100svh;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center; padding-top:4rem; padding-bottom:2rem;
  }
  .moon{
    width:64px; height:64px; border-radius:50%;
    background: radial-gradient(circle at 35% 30%, #FFF6DE, var(--gold) 70%);
    box-shadow: 0 0 50px 12px rgba(232,184,109,0.35);
    margin-bottom:1.6rem;
    animation: rise 2.4s ease-out;
  }
  @keyframes rise{ from{ opacity:0; transform:translateY(24px);} to{opacity:1; transform:translateY(0);} }

  .hero-eyebrow{ margin-bottom:1.2rem; animation: rise 2.2s ease-out; }
  #hero h1{
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    line-height:1.08;
    color: var(--cream);
    animation: rise 2.6s ease-out;
  }
  #hero h1 span{
    display:block;
    color: var(--gold);
    font-style:italic;
  }
  #hero .sub{
    margin-top:1.4rem; max-width:520px;
    font-size:1.05rem; font-weight:300; line-height:1.8;
    color: rgba(253,246,236,0.82);
    animation: rise 3s ease-out;
  }

  /* countdown as glowing petals */
  #countdown{
    display:flex; gap:1rem; margin-top:3.2rem; flex-wrap:wrap; justify-content:center;
    animation: rise 3.2s ease-out;
  }
  .petal{
    width:96px; padding:1.1rem 0.4rem;
    border-radius: 50% 50% 46% 46% / 60% 60% 40% 40%;
    background: linear-gradient(160deg, rgba(242,169,190,0.16), rgba(232,184,109,0.10));
    border:1px solid var(--line);
    backdrop-filter: blur(6px);
    text-align:center;
  }
  .petal .num{
    font-family:'Playfair Display', serif; font-size:1.9rem; color: var(--gold);
    display:block;
  }
  .petal .lbl{
    font-size:0.62rem; letter-spacing:2px; text-transform:uppercase;
    color: rgba(253,246,236,0.65); display:block; margin-top:0.2rem;
  }

  .scroll-hint{
    margin-top:3.4rem; font-size:0.7rem; letter-spacing:3px; text-transform:uppercase;
    color: rgba(253,246,236,0.45);
    animation: bob 2.4s ease-in-out infinite;
  }
  @keyframes bob{ 0%,100%{transform:translateY(0);} 50%{transform:translateY(8px);} }

  /* ---------- divider ---------- */
  .divider{
    width:100%; max-width:920px; margin:0 auto;
    display:flex; align-items:center; gap:1rem; padding: 0 1.5rem;
  }
  .divider::before, .divider::after{
    content:''; flex:1; height:1px;
    background: linear-gradient(90deg, transparent, var(--line), transparent);
  }
  .divider span{ color: var(--gold); font-size:1.1rem; }

  /* ---------- Love letter ---------- */
  #surat{ text-align:center; }
  #surat h2{ font-size: clamp(1.8rem, 4vw, 2.6rem); color: var(--cream); margin-bottom:0.6rem; }
  #surat .to{ font-size:1rem; color:var(--gold); margin-bottom:2.2rem; }
  .letter{
    text-align:left;
    background: linear-gradient(160deg, rgba(255,255,255,0.035), rgba(255,255,255,0.01));
    border:1px solid var(--line);
    border-radius:18px;
    padding: 2.6rem clamp(1.4rem, 5vw, 3.4rem);
    font-size:1.02rem; line-height:2.05; font-weight:300;
    color: rgba(253,246,236,0.92);
  }
  .letter p{ margin-bottom:1.3rem; }
  .letter .sign{
    font-family:'Dancing Script', cursive; font-size:1.8rem; color: var(--blush);
    margin-top:1rem; text-align:right;
  }

  /* ---------- Gallery ---------- */
  #galeri{ text-align:center; }
  #galeri h2{ font-size: clamp(1.8rem, 4vw, 2.6rem); margin-bottom:0.6rem; }
  #galeri .desc{ color: rgba(253,246,236,0.65); font-weight:300; margin-bottom:2.6rem; max-width:480px; margin-left:auto; margin-right:auto; }
  .gallery-grid{
    display:grid; grid-template-columns: repeat(3, 1fr); gap:1.1rem;
  }
  @media (max-width:640px){ .gallery-grid{ grid-template-columns: repeat(2, 1fr); } }
  .frame{
    position:relative; aspect-ratio: 4/5;
    background: linear-gradient(160deg, rgba(242,169,190,0.10), rgba(92,53,133,0.35));
    border:1px solid var(--line);
    border-radius:10px;
    display:flex; align-items:center; justify-content:center;
    cursor:pointer; overflow:hidden;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .frame:hover{ transform: translateY(-6px) rotate(-0.5deg); box-shadow: 0 18px 34px rgba(0,0,0,0.35); }
  .frame img{ width:100%; height:100%; object-fit:cover; }
  .frame .placeholder{ text-align:center; color: rgba(253,246,236,0.55); font-size:0.72rem; padding:0.8rem; }
  .frame .placeholder .heart{ font-size:1.5rem; display:block; margin-bottom:0.4rem; opacity:0.7; }
  .frame input{ display:none; }
  .frame .badge{
    position:absolute; bottom:8px; right:8px; font-size:0.6rem;
    background: rgba(22,11,46,0.65); padding:3px 8px; border-radius:20px; color:var(--gold);
    letter-spacing:1px; text-transform:uppercase;
  }

  /* ---------- Quotes ---------- */
  #kata{ text-align:center; }
  #kata h2{ font-size: clamp(1.8rem, 4vw, 2.6rem); margin-bottom:2.6rem; }
  .quote-box{
    position:relative; min-height:190px;
    display:flex; align-items:center; justify-content:center;
  }
  .quote-slide{
    position:absolute; inset:0;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    opacity:0; transition: opacity 0.9s ease;
    padding: 0 1rem;
  }
  .quote-slide.active{ opacity:1; }
  .quote-slide p{
    font-family:'Playfair Display', serif; font-style:italic;
    font-size: clamp(1.15rem, 2.6vw, 1.55rem);
    color: var(--cream); line-height:1.6; max-width:640px;
  }
  .quote-slide .mark{ color: var(--gold); font-size:1rem; letter-spacing:2px; margin-top:1.2rem; text-transform:uppercase; }
  .dots{ display:flex; gap:8px; justify-content:center; margin-top:2.2rem; }
  .dot{ width:7px; height:7px; border-radius:50%; background: rgba(253,246,236,0.25); cursor:pointer; transition:background 0.3s; }
  .dot.active{ background: var(--gold); }

  /* ---------- Reasons ---------- */
  #alasan{ text-align:center; }
  #alasan h2{ font-size: clamp(1.8rem, 4vw, 2.6rem); margin-bottom:2.6rem; }
  .reason-grid{ display:grid; grid-template-columns:repeat(3, 1fr); gap:1.4rem; text-align:left; }
  @media (max-width:820px){ .reason-grid{ grid-template-columns:1fr 1fr; } }
  @media (max-width:520px){ .reason-grid{ grid-template-columns:1fr; } }
  .reason h3{ font-size:1rem; margin-top:0.7rem; color: var(--cream); }
  .reason{
    padding:1.6rem; border:1px solid var(--line); border-radius:14px;
    background: rgba(255,255,255,0.02);
  }
  .reason .heart-ico{ color:var(--blush); font-size:1.1rem; }
  .reason p{ margin-top:0.6rem; font-weight:300; line-height:1.7; color: rgba(253,246,236,0.85); font-size:0.95rem; }

  /* ---------- Surprise / finale: cake + gift ---------- */
  #kado{ text-align:center; padding-bottom:9rem; }
  #kado h2{ font-size: clamp(1.8rem, 4vw, 2.6rem); margin-bottom:1rem; }
  #kado .desc{ color: rgba(255,246,242,0.65); font-weight:300; margin-bottom:3.2rem; }

  .celebrate-wrap{
    display:flex; gap:4.5rem; justify-content:center; align-items:flex-end; flex-wrap:wrap;
  }
  .cake-stage, .gift-stage{ display:flex; flex-direction:column; align-items:center; }
  .stage-label{
    margin-top:1.4rem; font-size:0.68rem; letter-spacing:2px; text-transform:uppercase;
    color: rgba(255,246,242,0.5);
  }

  /* --- cake --- */
  .cake{
    position:relative; width:180px; height:158px; background:none; border:none;
    padding:0; cursor:pointer; -webkit-tap-highlight-color:transparent;
  }
  .cake .plate{
    position:absolute; bottom:0; left:50%; transform:translateX(-50%);
    width:194px; height:12px; border-radius:50%;
    background: radial-gradient(ellipse at center, rgba(217,162,92,0.55), transparent 70%);
  }
  .cake .tier-bottom{
    position:absolute; bottom:10px; left:50%; transform:translateX(-50%);
    width:170px; height:64px;
    border-radius: 14px 14px 34px 34px / 14px 14px 22px 22px;
    background: linear-gradient(160deg, var(--blush), var(--plum-light));
    box-shadow: inset 0 -12px 18px rgba(0,0,0,0.18);
  }
  .cake .tier-top{
    position:absolute; bottom:64px; left:50%; transform:translateX(-50%);
    width:116px; height:50px;
    border-radius: 10px 10px 28px 28px / 10px 10px 18px 18px;
    background: linear-gradient(160deg, #FFFDFB, var(--blush));
    box-shadow: inset 0 -8px 14px rgba(0,0,0,0.10);
  }
  .cake .tier-top::before{
    content:''; position:absolute; top:-7px; left:2px; right:2px; height:16px;
    background-image: radial-gradient(circle, #FFFDFB 42%, transparent 44%);
    background-size:15px 15px; background-repeat:repeat-x;
  }
  .cake .plaque{
    position:absolute; bottom:96px; left:50%; transform:translateX(-50%);
    width:32px; height:32px; border-radius:50%;
    background: var(--cream); color:var(--navy);
    font-family:'Playfair Display', serif; font-weight:700; font-size:0.82rem;
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 3px 8px rgba(0,0,0,0.25); z-index:3;
  }
  .cake .candle{
    position:absolute; bottom:126px; left:calc(50% + 44px);
    width:6px; height:32px; border-radius:2px;
    background: linear-gradient(180deg, var(--gold), #A8703B);
  }
  .cake .flame{
    position:absolute; top:-14px; left:50%; transform:translateX(-50%);
    width:10px; height:16px; border-radius:50% 50% 50% 50% / 62% 62% 38% 38%;
    background: radial-gradient(circle at 50% 32%, #FFEFC0, #FF9B45 62%, transparent 72%);
    animation: flicker 1.3s ease-in-out infinite;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  @keyframes flicker{
    0%,100%{ transform:translateX(-50%) scale(1); }
    50%{ transform:translateX(-50%) scale(0.85) rotate(3deg); }
  }
  .cake.blown .flame{ opacity:0; transform:translateX(-50%) scale(0.2); animation:none; }
  .cake.blown{ animation: cake-pop 0.55s ease; }
  @keyframes cake-pop{
    0%{ transform:scale(1); }
    35%{ transform:scale(1.08) rotate(-2deg); }
    65%{ transform:scale(0.98) rotate(1deg); }
    100%{ transform:scale(1); }
  }

  .speech-bubble{
    opacity:0; transform:translateY(10px) scale(0.94);
    transition: opacity 0.5s ease, transform 0.5s ease;
    background: var(--cream); color:var(--navy);
    padding:0.85rem 1.2rem; border-radius:14px;
    font-family:'Playfair Display', serif; font-size:0.95rem; text-align:center;
    margin-bottom:1.1rem; max-width:230px; position:relative;
    box-shadow:0 12px 26px rgba(0,0,0,0.3);
  }
  .speech-bubble span{
    display:block; margin-top:0.3rem; font-size:0.7rem; font-weight:400;
    font-family:'Poppins', sans-serif; color: var(--plum-light);
  }
  .speech-bubble::after{
    content:''; position:absolute; bottom:-8px; left:50%; transform:translateX(-50%);
    border:8px solid transparent; border-top-color: var(--cream);
  }
  .speech-bubble.show{ opacity:1; transform:translateY(0) scale(1); }

  /* --- gift box --- */
  .giftbox{
    position:relative; width:120px; height:112px; background:none; border:none;
    padding:0; cursor:pointer; margin-bottom:1.3rem; -webkit-tap-highlight-color:transparent;
  }
  .giftbox .box-body{
    position:absolute; bottom:0; left:0; width:120px; height:68px;
    background: linear-gradient(160deg, var(--plum-light), var(--navy));
    border-radius:8px;
  }
  .giftbox .ribbon-v{
    position:absolute; bottom:0; left:50%; transform:translateX(-50%);
    width:14px; height:68px; background: var(--cream); opacity:0.9;
  }
  .giftbox .lid{
    position:absolute; bottom:64px; left:-5px; width:130px; height:24px;
    background: linear-gradient(160deg, var(--gold), #A8703B);
    border-radius:6px; transform-origin: 6px 20px;
    transition: transform 0.6s cubic-bezier(.34,1.56,.64,1);
    z-index:3;
  }
  .giftbox .ribbon-h{
    position:absolute; bottom:64px; left:-5px; width:130px; height:8px;
    background: var(--cream); opacity:0.9; z-index:4;
    transition: opacity 0.3s ease;
  }
  .giftbox .bow{
    position:absolute; bottom:82px; left:50%; transform:translateX(-50%);
    width:28px; height:16px; background: var(--cream);
    border-radius:50% 50% 50% 50% / 60% 60% 40% 40%;
    z-index:5; transition: opacity 0.3s ease;
  }
  .giftbox.open .lid{ transform: rotate(-108deg) translate(2px,-2px); }
  .giftbox.open .ribbon-h, .giftbox.open .bow{ opacity:0; }

  .gift-note{
    max-width:230px; text-align:center; opacity:0; height:0; overflow:hidden;
    transition: opacity 0.6s ease;
  }
  .gift-note.show{ opacity:1; height:auto; }
  .gift-note p{
    font-family:'Playfair Display', serif; font-style:italic; line-height:1.7;
    color: var(--cream); font-size:0.98rem;
  }

  footer{
    text-align:center; padding: 2.4rem 1.5rem 3.2rem; font-size:0.75rem;
    color: rgba(253,246,236,0.4); letter-spacing:1px;
  }

  canvas#confetti{ position:fixed; inset:0; pointer-events:none; z-index:50; }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; }
  }
  button:focus-visible, .frame:focus-visible, .dot:focus-visible{ outline:2px solid var(--gold); outline-offset:3px; }
</style>
</head>
<body>

<div id="sky"></div>
<canvas id="confetti"></canvas>

<!-- HERO -->
<section id="hero">
  <div class="moon"></div>
  <p class="eyebrow hero-eyebrow">11 November 2026 · Genap 19 Tahun</p>
  <h1>Selamat Ulang Tahun<span>Gita Sari</span></h1>
  <p class="sub">Hari ini harimu. Semoga usia 19 membawa lebih banyak hal baik, dan terima kasih sudah menjadi bagian penting dalam hidupku.</p>

  <div id="countdown">
    <div class="petal"><span class="num" id="cd-hari">00</span><span class="lbl">Hari</span></div>
    <div class="petal"><span class="num" id="cd-jam">00</span><span class="lbl">Jam</span></div>
    <div class="petal"><span class="num" id="cd-menit">00</span><span class="lbl">Menit</span></div>
    <div class="petal"><span class="num" id="cd-detik">00</span><span class="lbl">Detik</span></div>
  </div>
  <p class="scroll-hint">menuju usia 19 — gulir ke bawah</p>
</section>

<div class="divider"><span>✦</span></div>

<!-- SURAT CINTA -->
<section id="surat">
  <p class="eyebrow">untuk kamu</p>
  <h2>Sepucuk Surat Kecil</h2>
  <p class="to script">Untuk Gita Sari, cinta paling indah yang pernah kutemui</p>
  <div class="letter">
    <p>Gita,</p>
    <p>Selamat ulang tahun. Hari ini kamu resmi 19 tahun, dan aku ingin kamu tahu betapa bersyukurnya aku bisa menjalani perjalanan ini bersamamu.</p>
    <p>Kamu adalah alasan hari-hari biasa terasa lebih berarti — cara kamu peduli, cara kamu menghadapi hari-harimu, dan caramu selalu bisa membuatku merasa tenang.</p>
    <p>Semoga tahun ini membawa kesehatan, ketenangan hati, dan semua rencana baik yang sedang kamu perjuangkan bisa berjalan lancar.</p>
    <p class="sign">— selalu milikmu ♡</p>
  </div>
</section>

<div class="divider"><span>✦</span></div>

<!-- GALERI -->
<section id="galeri">
  <p class="eyebrow">kenangan kita</p>
  <h2>Galeri Wajah Gita</h2>
  <p class="desc">Klik salah satu bingkai untuk menambahkan fotomu sendiri — biar galeri ini benar-benar jadi milikmu berdua.</p>
  <div class="gallery-grid" id="gallery-grid"></div>
</section>

<div class="divider"><span>✦</span></div>

<!-- KATA MUTIARA -->
<section id="kata">
  <p class="eyebrow">kata-kata untukmu</p>
  <h2>Kata Mutiara Hari Ini</h2>
  <div class="quote-box" id="quote-box"></div>
  <div class="dots" id="quote-dots"></div>
</section>

<div class="divider"><span>✦</span></div>

<!-- ALASAN -->
<section id="alasan">
  <p class="eyebrow">tentang kamu</p>
  <h2>Beberapa Hal yang Kucintai Darimu</h2>
  <div class="reason-grid">
    <div class="reason">
      <span class="heart-ico">♡</span>
      <h3>Suaramu</h3>
      <p>Aku suka caramu bicara — tenang, hangat, dan selalu berhasil membuatku merasa nyaman.</p>
    </div>
    <div class="reason">
      <span class="heart-ico">♡</span>
      <h3>Senyummu</h3>
      <p>Senyum di bibirmu adalah salah satu hal favoritku untuk dilihat setiap hari.</p>
    </div>
    <div class="reason">
      <span class="heart-ico">♡</span>
      <h3>Selalu Ada</h3>
      <p>Terima kasih selalu mendukungku dan selalu ada, apa pun keadaannya.</p>
    </div>
  </div>
</section>

<div class="divider"><span>✦</span></div>

<!-- KADO / KEJUTAN -->
<section id="kado">
  <p class="eyebrow">satu lagi untukmu</p>
  <h2>Tiup Lilin, Buka Hadiah</h2>
  <p class="desc">Sentuh kuenya untuk merayakan usia 19-mu, lalu buka kotak hadiah di sampingnya.</p>

  <div class="celebrate-wrap">
    <div class="cake-stage">
      <div class="speech-bubble" id="cake-msg">
        Selamat Ulang Tahun, Gita Sari
        <span>19 tahun yang membanggakan</span>
      </div>
      <button class="cake" id="cake-btn" aria-label="Sentuh untuk merayakan">
        <span class="candle"><span class="flame"></span></span>
        <span class="plaque">19</span>
        <span class="tier-top"></span>
        <span class="tier-bottom"></span>
        <span class="plate"></span>
      </button>
      <p class="stage-label">sentuh kue</p>
    </div>

    <div class="gift-stage">
      <button class="giftbox" id="gift-btn" aria-label="Sentuh untuk membuka hadiah">
        <span class="lid"></span>
        <span class="ribbon-v"></span>
        <span class="ribbon-h"></span>
        <span class="bow"></span>
        <span class="box-body"></span>
      </button>
      <div class="gift-note" id="gift-note">
        <p>Makasih ya udah selalu support dan selalu ada buat aku.</p>
      </div>
      <p class="stage-label">buka hadiah</p>
    </div>
  </div>
</section>

<footer>dibuat untuk Gita Sari — 11 November 2026</footer>

<script>
// ---------- Sky: stars + fireflies ----------
(function(){
  const skyCount = 90;
  for(let i=0;i<skyCount;i++){
    const s = document.createElement('div');
    s.className = 'star';
    const size = Math.random()*2 + 1;
    s.style.width = size+'px';
    s.style.height = size+'px';
    s.style.top = Math.random()*100+'vh';
    s.style.left = Math.random()*100+'vw';
    s.style.animationDelay = (Math.random()*4)+'s';
    s.style.animationDuration = (3+Math.random()*3)+'s';
    document.body.appendChild(s);
  }
  const heartSVG = '<svg viewBox="0 0 32 29" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M16 29 2.7 16.7C-1.6 12.7-.6 6 4.6 3.4c3.5-1.8 7.7-.8 9.9 2.2l1.5 2 1.5-2c2.2-3 6.4-4 9.9-2.2 5.2 2.6 6.2 9.3 1.9 13.3L16 29Z"/></svg>';
  const heartCount = 16;
  for(let i=0;i<heartCount;i++){
    const h = document.createElement('div');
    h.className = 'heart-float';
    const size = 10 + Math.random()*16;
    h.style.width = size+'px';
    h.style.height = size+'px';
    h.style.left = (Math.random()*100)+'vw';
    h.style.setProperty('--drift', (Math.random()*60-30)+'px');
    h.style.setProperty('--spin', (Math.random()*30-15)+'deg');
    h.style.animationDuration = (12+Math.random()*10)+'s';
    h.style.animationDelay = (Math.random()*16)+'s';
    h.innerHTML = heartSVG;
    document.body.appendChild(h);
  }
})();

// ---------- Countdown to 11 Nov 2026 ----------
(function(){
  const target = new Date('2026-11-11T00:00:00');
  function update(){
    const now = new Date();
    let diff = target - now;
    if(diff < 0) diff = 0;
    const d = Math.floor(diff / (1000*60*60*24));
    const h = Math.floor((diff / (1000*60*60)) % 24);
    const m = Math.floor((diff / (1000*60)) % 60);
    const s = Math.floor((diff / 1000) % 60);
    document.getElementById('cd-hari').textContent = String(d).padStart(2,'0');
    document.getElementById('cd-jam').textContent = String(h).padStart(2,'0');
    document.getElementById('cd-menit').textContent = String(m).padStart(2,'0');
    document.getElementById('cd-detik').textContent = String(s).padStart(2,'0');
  }
  update();
  setInterval(update, 1000);
})();

// ---------- Gallery with client-side photo upload (in-memory only) ----------
(function(){
  const grid = document.getElementById('gallery-grid');
  const total = 6;
  for(let i=0;i<total;i++){
    const frame = document.createElement('label');
    frame.className = 'frame';
    frame.tabIndex = 0;
    frame.innerHTML = `
      <div class="placeholder">
        <span class="heart">♡</span>
        Tambah foto Gita
      </div>
      <input type="file" accept="image/*">
      <span class="badge">+ foto</span>
    `;
    const input = frame.querySelector('input');
    input.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if(!file) return;
      const reader = new FileReader();
      reader.onload = (ev) => {
        frame.innerHTML = `<img src="${ev.target.result}" alt="Foto Gita Sari">`;
        frame.appendChild(input);
      };
      reader.readAsDataURL(file);
    });
    grid.appendChild(frame);
  }
})();

// ---------- Quotes carousel ----------
(function(){
  const quotes = [
    "Cinta bukan tentang usia yang bertambah, tapi tentang hati yang semakin dewasa dalam menyayangi.",
    "Semoga tahun ini menjadi babak paling bahagia dalam ceritamu, Gita.",
    "Kebahagiaanmu adalah doa yang selalu kupanjatkan diam-diam setiap hari.",
    "Selamat bertambah usia — semoga semua rencana baikmu berjalan tanpa terburu-buru.",
    "Kamu tidak perlu sempurna untuk dicintai sepenuh hati, karena kamu sudah cukup, apa adanya.",
    "Setiap ulang tahun adalah pengingat: hidupmu adalah kado untuk banyak orang di sekitarmu, termasuk aku."
  ];
  const box = document.getElementById('quote-box');
  const dotsWrap = document.getElementById('quote-dots');
  quotes.forEach((q, i) => {
    const slide = document.createElement('div');
    slide.className = 'quote-slide' + (i===0 ? ' active' : '');
    slide.innerHTML = `<p>&ldquo;${q}&rdquo;</p><span class="mark">Untuk Gita Sari</span>`;
    box.appendChild(slide);

    const dot = document.createElement('button');
    dot.className = 'dot' + (i===0 ? ' active' : '');
    dot.setAttribute('aria-label', 'Kutipan ' + (i+1));
    dot.addEventListener('click', () => showQuote(i));
    dotsWrap.appendChild(dot);
  });
  const slides = box.querySelectorAll('.quote-slide');
  const dots = dotsWrap.querySelectorAll('.dot');
  let current = 0;
  function showQuote(i){
    slides[current].classList.remove('active');
    dots[current].classList.remove('active');
    current = i;
    slides[current].classList.add('active');
    dots[current].classList.add('active');
  }
  setInterval(() => { showQuote((current+1) % slides.length); }, 5500);
})();

// ---------- Confetti engine (origin-aware, mix of hearts + squares) ----------
const confettiEngine = (function(){
  const canvas = document.getElementById('confetti');
  const ctx = canvas.getContext('2d');
  function resize(){ canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
  resize();
  window.addEventListener('resize', resize);

  const colors = ['#D9A25C', '#F0B7C4', '#FFF6F2', '#9C3B54'];
  let particles = [];
  let running = false;

  function heartPath(size){
    const p = new Path2D();
    p.moveTo(0, size*0.32);
    p.bezierCurveTo(0, 0, -size*0.55, 0, -size*0.55, size*0.32);
    p.bezierCurveTo(-size*0.55, size*0.62, 0, size*0.82, 0, size);
    p.bezierCurveTo(0, size*0.82, size*0.55, size*0.62, size*0.55, size*0.32);
    p.bezierCurveTo(size*0.55, 0, 0, 0, 0, size*0.32);
    return p;
  }

  function launch(originX, originY, count){
    count = count || 130;
    for(let i=0;i<count;i++){
      particles.push({
        x: originX + (Math.random()-0.5)*70,
        y: originY + (Math.random()-0.5)*40,
        vx: (Math.random()-0.5)*11,
        vy: Math.random()*-11 - 4,
        size: Math.random()*7+4,
        color: colors[Math.floor(Math.random()*colors.length)],
        rot: Math.random()*360,
        vrot: (Math.random()-0.5)*12,
        shape: Math.random() < 0.4 ? 'heart' : 'square',
        life: 0
      });
    }
    if(!running){ running = true; requestAnimationFrame(animate); }
  }

  function animate(){
    ctx.clearRect(0,0,canvas.width,canvas.height);
    let alive = false;
    particles = particles.filter(p => p.y < canvas.height + 30 && p.life < 280);
    particles.forEach(p => {
      p.vy += 0.22;
      p.x += p.vx;
      p.y += p.vy;
      p.rot += p.vrot;
      p.life++;
      alive = true;
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot * Math.PI/180);
      ctx.fillStyle = p.color;
      if(p.shape === 'heart'){
        ctx.fill(heartPath(p.size*0.7));
      } else {
        ctx.fillRect(-p.size/2, -p.size/2, p.size, p.size*0.6);
      }
      ctx.restore();
    });
    if(alive){ requestAnimationFrame(animate); }
    else { running = false; ctx.clearRect(0,0,canvas.width,canvas.height); }
  }

  return { launch };
})();

// ---------- Cake: tap to celebrate ----------
(function(){
  const cake = document.getElementById('cake-btn');
  const msg = document.getElementById('cake-msg');

  function speak(){
    try{
      if(!('speechSynthesis' in window)) return;
      const utter = new SpeechSynthesisUtterance('Selamat ulang tahun, Gita Sari');
      const voices = window.speechSynthesis.getVoices();
      const idVoice = voices.find(v => v.lang && v.lang.toLowerCase().startsWith('id'));
      if(idVoice) utter.voice = idVoice;
      utter.rate = 0.95;
      window.speechSynthesis.speak(utter);
    }catch(e){ /* speech not available, silently ignore */ }
  }

  cake.addEventListener('click', () => {
    cake.classList.remove('blown');
    void cake.offsetWidth; // restart animation
    cake.classList.add('blown');
    msg.classList.add('show');
    const rect = cake.getBoundingClientRect();
    confettiEngine.launch(rect.left + rect.width/2, rect.top + rect.height*0.35, 150);
    speak();
  });
})();

// ---------- Gift box: tap to open ----------
(function(){
  const gift = document.getElementById('gift-btn');
  const note = document.getElementById('gift-note');
  gift.addEventListener('click', () => {
    const opening = !gift.classList.contains('open');
    gift.classList.toggle('open');
    note.classList.toggle('show');
    if(opening){
      const rect = gift.getBoundingClientRect();
      confettiEngine.launch(rect.left + rect.width/2, rect.top + rect.height*0.3, 80);
    }
  });
})();
</script>
</body>
</html>
